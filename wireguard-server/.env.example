# Asosiy backend manzili (peer ro'yxati shu yerdan HTTPS orqali olinadi)
BACKEND_URL=https://maktab.ecos.uz

# backend/.env dagi WG_SYNC_SECRET bilan BIR XIL bo'lishi shart
WG_SYNC_SECRET=

# Ixtiyoriy — standart qiymatlar odatda yetarli
# DIQQAT (2026-09-16 aniqlandi): agar router konfiguratsiyasi to'g'ri bo'lsa-yu (kalit,
# manzil to'g'ri), handshake HECH QACHON tugallanmasa — ba'zi provayderlar aynan standart
# WireGuard portini (51820) bir tomonlama filtrlaydi (router->server o'tadi, server->router
# javobi yo'qoladi), boshqa portlarga tegmaydi. Tekshirish: shu portni boshqasiga
# (masalan 51823) o'zgartirib, WG_SERVER_PORT (backend/.env) va WG_HUB_ENDPOINT
# (wg-gateway) qiymatlarini ham moslang, keyin qayta urinib ko'ring.
WG_LISTEN_PORT=51820
WG_SERVER_SUBNET=10.20.0.1/24
SYNC_INTERVAL=15
